# --- LLM (pick one) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-from-google-ai-studio
# Model ids change often. Copy the current Flash model id from AI Studio if this alias stops working.
GEMINI_MODEL=gemini-flash-latest

# OpenAI-compatible alternative (OpenAI, Groq, OpenRouter...):
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=...
# LLM_MODEL=...

# --- Retrieval: chroma (semantic) or tfidf (no model download, instant) ---
RETRIEVER=chroma

# --- Web ---
CORS_ORIGINS=*
# MAX_DRAFT_CHARS=6000
# LLM_AUDITS_PER_10MIN=30
